# Payload CMS
# Long random string used to sign admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=
# Local SQLite file, or a libSQL/Turso URL in production (libsql://your-db.turso.io)
DATABASE_URL=file:./highrocks.db
# Only for Turso/libSQL
DATABASE_AUTH_TOKEN=
# Set to false to skip seeding the starting content into an empty database
PAYLOAD_SEED=true

# Site
NEXT_PUBLIC_SITE_URL=https://highrocks.app
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
