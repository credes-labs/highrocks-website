# Payload CMS
# Long random string used to sign admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=
# Local SQLite file, or a libSQL/Turso URL in production (libsql://your-db.turso.io)
DATABASE_URL=file:./highrocks.db
# Only for Turso/libSQL
DATABASE_AUTH_TOKEN=
# Set to false to skip seeding the starting content into an empty database
PAYLOAD_SEED=true

# Site
NEXT_PUBLIC_SITE_URL=https://highrocks.app
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Email (waitlist confirmations, admin password resets) via Resend. Without these, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@yourdomain.com
EMAIL_FROM_NAME=HighRocks

# Cloudflare Turnstile bot check on the waitlist forms (optional; both keys or neither)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
